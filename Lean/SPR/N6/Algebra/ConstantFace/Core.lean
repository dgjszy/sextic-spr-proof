import SPR.N6.Algebra.FirstBand.Source

/-!
# The two-fixed-even-coefficient face

These static polynomial formulas are normalized from the same lower zero
source. Positivity includes both endpoints of the canonical ratio interval.
-/
namespace SPR.N6.ConstantFace
noncomputable section
set_option maxRecDepth 8192
set_option maxHeartbeats 0

def c0 (e f g m : ℝ) : ℝ :=
  (((((((((3) * m) * f + (((5) * m) * g)) * f + (((2) * m) * g ^ 2)) * f) * e + (((((((1) * m +
    (15)) * m) * f + ((((1) * m + (31)) * m) * g)) * f + (((20) * m) * g ^ 2)) * f + (((4) * m)
    * g ^ 3)) * f)) * e + ((((((((5) * m + (30)) * m) * f + ((((7) * m + (74)) * m) * g)) * f +
    ((((2) * m + (63)) * m) * g ^ 2)) * f + (((21) * m) * g ^ 3)) * f + (((2) * m) * g ^ 4)) *
    f)) * e + ((((((((10) * m + (30)) * m) * f + ((((18) * m + (86)) * m) * g)) * f + ((((9) * m
    + (89)) * m) * g ^ 2)) * f + ((((1) * m + (39)) * m) * g ^ 3)) * f + (((6) * m) * g ^ 4)) *
    f ^ 2)) * e + ((((((((9) * m + (15)) * m) * f + ((((19) * m + (49)) * m) * g)) * f + ((((12)
    * m + (59)) * m) * g ^ 2)) * f + ((((2) * m + (31)) * m) * g ^ 3)) * f + (((6) * m) * g ^
    4)) * f ^ 3)) * e + ((((((((3) * m + (3)) * m) * f + ((((7) * m + (11)) * m) * g)) * f +
    ((((5) * m + (15)) * m) * g ^ 2)) * f + ((((1) * m + (9)) * m) * g ^ 3)) * f + (((2) * m) *
    g ^ 4)) * f ^ 4)

def c1 (e f g m : ℝ) : ℝ :=
  ((((((((3) * m) * f + (((5) * m) * g)) * f + (((2) * m) * g ^ 2)) * f) * e + ((((((1) * m +
    (10)) * m) * f + ((((1) * m + (17)) * m) * g)) * f + (((7) * m) * g ^ 2)) * f ^ 2)) * e +
    (((((((3) * m + (11)) * m) * f + ((((3) * m + (16)) * m) * g)) * f ^ 2 + (((-7) * m) * g ^
    3)) * f + (((-2) * m) * g ^ 4)) * f)) * e + (((((((2) * m + (4)) * m) * f ^ 2 + ((((-3) * m
    + (-16)) * m) * g ^ 2)) * f + ((((-1) * m + (-17)) * m) * g ^ 3)) * f + (((-5) * m) * g ^
    4)) * f ^ 2)) * e + ((((((((-2) * m + (-4)) * m) * g) * f + ((((-3) * m + (-11)) * m) * g ^
    2)) * f + ((((-1) * m + (-10)) * m) * g ^ 3)) * f + (((-3) * m) * g ^ 4)) * f ^ 3)

def c2 (e f g m : ℝ) : ℝ :=
  ((((((2) * f + ((1) * g)) * e + ((((1) * m + (13)) * f + ((14) * g)) * f + ((4) * g ^ 2))) * e
    + (((((1) * m + (35)) * f + (((-6) * m + (58)) * g)) * f + (((-4) * m + (32)) * g ^ 2)) * f
    + ((6) * g ^ 3))) * e + (((((((-2) * m + (2)) * m + (48)) * f + ((((-2) * m + (-15)) * m +
    (109)) * g)) * f + (((-18) * m + (90)) * g ^ 2)) * f + (((-4) * m + (32)) * g ^ 3)) * f +
    ((4) * g ^ 4))) * e + ((((((((-5) * m + (8)) * m + (33)) * f + ((((-7) * m + (-2)) * m +
    (97)) * g)) * f + ((((-2) * m + (-15)) * m + (109)) * g ^ 2)) * f + (((-6) * m + (58)) * g ^
    3)) * f + ((14) * g ^ 4)) * f + ((1) * g ^ 5))) * e + (((((((((-3) * m + (6)) * m + (9)) * f
    + ((((-5) * m + (8)) * m + (33)) * g)) * f + ((((-2) * m + (2)) * m + (48)) * g ^ 2)) * f +
    (((1) * m + (35)) * g ^ 3)) * f + (((1) * m + (13)) * g ^ 4)) * f + ((2) * g ^ 5)) * f)

def P (e f g m t : ℝ) : ℝ := c0 e f g m+c1 e f g m*t+c2 e f g m*t^2

def determinant (e f g m : ℝ) : ℝ := 4*c0 e f g m*c2 e f g m-(c1 e f g m)^2

end
end SPR.N6.ConstantFace
