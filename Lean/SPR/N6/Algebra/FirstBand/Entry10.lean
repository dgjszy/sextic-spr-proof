-- Kernel normalization is restricted to one parameter coefficient.
theorem identity3 (a d e f g h : ℝ) :
    Split.block103 d e f g (w0 a d e f g h) (w1 a d e f g h) (den a d e f g h) (jump a d e f g h) (Split.l0a d e f g h) (Split.l1c d e f g h) (Split.l1a d e f g h) (Split.l2c d e f g h) (Split.l2a d e f g h) (Split.hc d e f g h) (Split.ha d e f g h) (Split.haa d e f g h) (z00 a d e f g h) (z01 a d e f g h) (z02 a d e f g h) (z10 a d e f g h) (z11 a d e f g h) (z12 a d e f g h) (z20 a d e f g h) (z21 a d e f g h) (z22 a d e f g h) = value3 d e f g h := by
  simp only [Split.block103, w0,w1,den,jump,
    Split.l0a,Split.l1c,Split.l1a,Split.l2c,Split.l2a,Split.hc,Split.ha,Split.haa,
    z00,z01,z02,z10,z11,z12,z20,z21,z22,value3] <;> ring

