-- Kernel normalization is restricted to one parameter coefficient.
theorem identity3 (a d e f g h : ℝ) :
    Split.block203 d e f g (w0 a d e f g h) (w1 a d e f g h) (den a d e f g h) (jump a d e f g h) (Split.l0a d e f g h) (Split.l1c d e f g h) (Split.l1a d e f g h) (Split.l2c d e f g h) (Split.l2a d e f g h) (Split.hc d e f g h) (Split.ha d e f g h) (Split.haa d e f g h) (z00 a d e f g h) (z01 a d e f g h) (z02 a d e f g h) (z10 a d e f g h) (z11 a d e f g h) (z12 a d e f g h) (z20 a d e f g h) (z21 a d e f g h) (z22 a d e f g h) = value3 d e f g h := by
  simp only [Split.block203, w0,w1,den,jump,
    Split.l0a,Split.l1c,Split.l1a,Split.l2c,Split.l2a,Split.hc,Split.ha,Split.haa,
    z00,z01,z02,z10,z11,z12,z20,z21,z22,value3] <;> ring

set_option maxHeartbeats 0 in
-- Recursive positivity constructs an ordinary kernel proof of this static expression.
theorem positive3 {d e f g h : ℝ} (hd : 0 < d) (he : 0 < e) (hf : 0 < f)
    (hg : 0 < g) (hh : 0 < h) : 0 < value3 d e f g h := by
  unfold value3
  positivity

def value (a d e f g h : ℝ) : ℝ :=
  value0 d e f g h+a*value1 d e f g h+a^2*value2 d e f g h+a^3*value3 d e f g h

/-- The four coefficient identities reassemble the exact source entry. -/
theorem identity (a d e f g h : ℝ) :
    2*f^2*(actual20 a d e f g h+actual21 a d e f g h+actual22 a d e f g h) = value a d e f g h := by
  obtain ⟨h0,h1,h2,hF⟩ := Split.scalar_decomposition a d e f g h
  have hi := Split.decompose20 a d e f g (w0 a d e f g h) (w1 a d e f g h) (den a d e f g h) (jump a d e f g h) (Split.l0a d e f g h) (Split.l1c d e f g h) (Split.l1a d e f g h) (Split.l2c d e f g h) (Split.l2a d e f g h) (Split.hc d e f g h) (Split.ha d e f g h) (Split.haa d e f g h) (z00 a d e f g h) (z01 a d e f g h) (z02 a d e f g h) (z10 a d e f g h) (z11 a d e f g h) (z12 a d e f g h) (z20 a d e f g h) (z21 a d e f g h) (z22 a d e f g h)
  rw [identity0,identity1,identity2,identity3] at hi
  simpa only [actual20,actual21,actual22,h0,h1,h2,hF,value] using hi

/-- Strict positivity on positive roots and gaps. -/
theorem positive {a d e f g h : ℝ} (ha : 0 < a) (hd : 0 < d) (he : 0 < e)
    (hf : 0 < f) (hg : 0 < g) (hh : 0 < h) : 0 < value a d e f g h := by
  have h0 := positive0 hd he hf hg hh
  have h1 := positive1 hd he hf hg hh
  have h2 := positive2 hd he hf hg hh
  have h3 := positive3 hd he hf hg hh
  unfold value
  positivity
end Entry20
