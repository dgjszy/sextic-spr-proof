    h)) * g)) * f + ((((-1) * m + (-8)) * g + ((-6) * h)) * g ^ 2)) * f + (((-2) * g + (((1) * m
    + (-2)) * h)) * g ^ 3)))) * d + ((((((-2) * f + ((-4) * g + ((-2) * h))) * f + (((-2) * g +
    ((-2) * h)) * g)) * e + (((((1) * m + (-6)) * f + (((3) * m + (-16)) * g + ((-6) * h))) * f
    + ((((2) * m + (-14)) * g + ((-10) * h)) * g)) * f + (((-4) * g + ((-4) * h)) * g ^ 2))) * e
    + ((((((1) * m ^ 2 + (-6)) * f + ((((1) * m + (3)) * m + (-20)) * g + (((1) * m + (-6)) *
    h))) * f + ((((5) * m + (-24)) * g + (((6) * m + (-14)) * h)) * g + (((3) * m) * h ^ 2))) *
    f + (((((2) * m + (-12)) * g + (((7) * m + (-10)) * h)) * g + (((4) * m) * h ^ 2)) * g)) * f
    + ((((-2) * g + (((2) * m + (-2)) * h)) * g + (((1) * m) * h ^ 2)) * g ^ 2))) * e +
    ((((((((1) * m + (-1)) * m + (-2)) * f + ((((2) * m + (-2)) * m + (-8)) * g + ((((1) * m +
    (-1)) * m + (-2)) * h))) * f + (((((1) * m + (-1)) * m + (-12)) * g + (((2) * m ^ 2 + (-6))
    * h)) * g + ((((1) * m + (1)) * m) * h ^ 2))) * f + ((((-8) * g + ((((1) * m + (3)) * m +
    (-6)) * h)) * g + ((((1) * m + (2)) * m) * h ^ 2)) * g)) * f + ((((-2) * g + (((2) * m +
    (-2)) * h)) * g + (((1) * m) * h ^ 2)) * g ^ 2)) * f))

def q12 (d e f g h m : R) : R :=
  ((((1) * m) * g ^ 2) * d + ((((1) * f + ((1) * g + ((1) * h))) * e + ((((1) * m + (2)) * f +
    (((1) * m + (4)) * g + (((2) * m + (2)) * h))) * f + ((((2) * m + (2)) * g + (((2) * m +
    (2)) * h)) * g))) * e + (((((1) * m + (1)) * f + ((((1) * m + (1)) * m + (3)) * g + ((((1) *
    m + (2)) * m + (1)) * h))) * f + ((((1) * m + (3)) * g + (((2) * m + (2)) * h)) * g)) * f +
    (((1) * g + ((1) * h)) * g ^ 2)))) * d + (((((1) * f + ((1) * g + ((1) * h))) * e + ((((-1)
    * m + (3)) * f + (((-2) * m + (5)) * g + (((1) * m + (3)) * h))) * f + (((2) * g + (((2) * m
