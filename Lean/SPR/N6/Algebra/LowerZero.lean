    + (1)) * f + ((((-1) * m + (-1)) * m + (3)) * g + (((1) * m + (1)) * h))) * f + ((((-1) * m
    + (3)) * g + (((1) * m + (2)) * h)) * g)) * f + (((1) * g + ((1) * h)) * g ^ 2)) * f))

def q1 (d e f g h m t : R) : R :=
  q10 d e f g h m+q11 d e f g h m*t+q12 d e f g h m*t^2

set_option maxHeartbeats 0 in
/-- Exact double-contact factorization of the lower zero source. -/
theorem source1 (d e f g h m t : ℝ) :
    m*(UpperInner.weight d e f g h m*t-UpperInner.weightedRoot d e f g h m)*
      (-(t+e)*t*(t-f-g-h))+UpperInner.odd d e f g h m t*(t+e)*(t-f-g) =
      (t+e)^2*q1 d e f g h m t := by
  unfold UpperInner.weight UpperInner.weightedRoot UpperInner.odd q1 q10 q11 q12
  ring

/-- Every coefficient operation commutes with ring homomorphisms. -/
theorem q0_map {S : Type*} [CommRing S] (φ : R →+* S) (d e f g h m t : R) :
    φ (q0 d e f g h m t) = q0 (φ d) (φ e) (φ f) (φ g) (φ h) (φ m) (φ t) := by
  simp [q0,q00,q01,q02,map_ofNat]

/-- The reflected source has the same functorial polynomial interpretation. -/
theorem q1_map {S : Type*} [CommRing S] (φ : R →+* S) (d e f g h m t : R) :
    φ (q1 d e f g h m t) = q1 (φ d) (φ e) (φ f) (φ g) (φ h) (φ m) (φ t) := by
  simp [q1,q10,q11,q12,map_ofNat]

end
end SPR.N6.LowerZero
