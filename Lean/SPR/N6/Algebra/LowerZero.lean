import SPR.N6.Algebra.UpperInner.Source

/-!
# Exact lower zero-direction source, with denominators cleared

Frequency is translated by B. These polynomial identities are used to link
local coefficient certificates to the same original candidate.
-/
namespace SPR.N6.LowerZero
noncomputable section
set_option maxRecDepth 8192
variable {R : Type*} [CommRing R]

def q00 (d e f g h m : R) : R :=
  ((((((1) * m) * f ^ 2) * e + (((((1) * m + (2)) * m) * f + (((2) * m) * g)) * f ^ 2)) * e +
    ((((((1) * m + (1)) * m) * f + (((2) * m) * g)) * f + (((1) * m) * g ^ 2)) * f ^ 2)) * d +
    ((((((1) * f + ((1) * g + ((1) * h))) * e + ((((3) * m + (2)) * f + (((1) * m + (4)) * g +
    (((1) * m + (2)) * h))) * f + (((2) * g + ((2) * h)) * g))) * e + ((((((1) * m + (6)) * m +
    (1)) * f + (((5) * m + (3)) * g + (((1) * m + (1)) * h))) * f + (((3) * g + ((2) * h)) * g))
    * f + (((1) * g + ((1) * h)) * g ^ 2))) * e + ((((((2) * m + (4)) * m) * f + (((6) * m) * g
    + (((-1) * m ^ 2) * h))) * f + (((2) * m) * g ^ 2)) * f ^ 2)) * e + ((((((1) * m + (1)) * m)
    * f + ((((1) * m + (2)) * m) * g)) * f + (((1) * m) * g ^ 2)) * f ^ 3))) * d + (((((((1) * f
    + ((1) * g + ((1) * h))) * e + ((((1) * m + (3)) * f + ((5) * g + ((3) * h))) * f + (((2) *
    g + ((2) * h)) * g))) * e + (((((4) * m + (3)) * f + (((3) * m + (7)) * g + ((3) * h))) * f
    + (((5) * g + (((-1) * m + (4)) * h)) * g + (((-1) * m) * h ^ 2))) * f + (((1) * g + ((1) *
    h)) * g ^ 2))) * e + (((((((1) * m + (4)) * m + (1)) * f + (((6) * m + (3)) * g + ((((-1) *
    m + (1)) * m + (1)) * h))) * f + ((((2) * m + (3)) * g + (((1) * m + (2)) * h)) * g)) * f +
    (((1) * g + ((1) * h)) * g ^ 2)) * f)) * e + ((((((1) * m + (1)) * m) * f + ((((1) * m +
    (2)) * m) * g)) * f + (((1) * m) * g ^ 2)) * f ^ 3)) * e)

def q01 (d e f g h m : R) : R :=
  ((((((-1) * m) * f + (((-1) * m) * g)) * e + (((((-1) * m + (-2)) * m) * f + (((-4) * m) * g))
    * f)) * e + ((((((-1) * m + (-1)) * m) * f + (((-3) * m) * g)) * f + (((-2) * m) * g ^ 2)) *
    f)) * d + ((((((-2) * m + (2)) * f + (((-2) * m + (2)) * g + (((-1) * m + (2)) * h))) * e +
    (((((-1) * m + (-3)) * m + (4)) * f + (((-7) * m + (8)) * g + ((4) * h))) * f + (((4) * g +
    (((1) * m + (4)) * h)) * g))) * e + ((((((-2) * m + (-2)) * m + (2)) * f + (((-8) * m + (6))
    * g + (((1) * m ^ 2 + (2)) * h))) * f + ((((-4) * m + (6)) * g + ((4) * h)) * g)) * f +
    (((2) * g + ((2) * h)) * g ^ 2))) * e + ((((((-1) * m + (-1)) * m) * f + ((((-2) * m + (-3))
    * m) * g + ((((-1) * m + (-1)) * m) * h))) * f + ((((-2) * m) * g + (((-1) * m) * h)) * g))
    * f ^ 2))) * d + ((((((2) * f + ((2) * g + ((2) * h))) * e + (((6) * f + (((-2) * m + (10))
    * g + (((1) * m + (6)) * h))) * f + (((4) * g + (((2) * m + (4)) * h)) * g + (((1) * m) * h
    ^ 2)))) * e + ((((((-1) * m + (3)) * m + (6)) * f + (((-1) * m + (14)) * g + ((((1) * m +
    (1)) * m + (6)) * h))) * f + ((((-2) * m + (10)) * g + ((8) * h)) * g + (((-1) * m) * h ^
    2))) * f + (((2) * g + ((2) * h)) * g ^ 2))) * e + ((((((4) * m + (2)) * f + ((((-1) * m +
    (5)) * m + (6)) * g + ((((-1) * m + (2)) * m + (2)) * h))) * f + ((((1) * m + (6)) * g +
    (((2) * m + (4)) * h)) * g)) * f + (((2) * g + ((2) * h)) * g ^ 2)) * f)) * e + ((((((1) * m
    + (1)) * m) * f + ((((1) * m + (2)) * m) * g)) * f + (((1) * m) * g ^ 2)) * f ^ 3))

def q02 (d e f g h m : R) : R :=
  ((((1) * m) * g ^ 2) * d + ((((1) * f + ((1) * g + ((1) * h))) * e + ((((1) * m + (2)) * f +
    (((1) * m + (4)) * g + (((2) * m + (2)) * h))) * f + ((((2) * m + (2)) * g + (((2) * m +
    (2)) * h)) * g))) * e + (((((1) * m + (1)) * f + ((((1) * m + (1)) * m + (3)) * g + ((((1) *
    m + (2)) * m + (1)) * h))) * f + ((((1) * m + (3)) * g + (((2) * m + (2)) * h)) * g)) * f +
    (((1) * g + ((1) * h)) * g ^ 2)))) * d + (((((1) * f + ((1) * g + ((1) * h))) * e + ((((-1)
    * m + (3)) * f + (((-2) * m + (5)) * g + (((1) * m + (3)) * h))) * f + (((2) * g + (((2) * m
    + (2)) * h)) * g + (((1) * m) * h ^ 2)))) * e + ((((((-1) * m + (-1)) * m + (3)) * f +
    (((-4) * m + (7)) * g + ((((1) * m + (1)) * m + (3)) * h))) * f + ((((-2) * m + (5)) * g +
    (((1) * m + (4)) * h)) * g)) * f + (((1) * g + ((1) * h)) * g ^ 2))) * e + ((((((-1) * m ^ 2
    + (1)) * f + ((((-1) * m + (-1)) * m + (3)) * g + (((1) * m + (1)) * h))) * f + ((((-1) * m
    + (3)) * g + (((1) * m + (2)) * h)) * g)) * f + (((1) * g + ((1) * h)) * g ^ 2)) * f))

def q0 (d e f g h m t : R) : R :=
  q00 d e f g h m+q01 d e f g h m*t+q02 d e f g h m*t^2

set_option maxHeartbeats 0 in
/-- Exact double-contact factorization of the lower zero source. -/
theorem source0 (d e f g h m t : ℝ) :
    m*(UpperInner.weight d e f g h m*t-UpperInner.weightedRoot d e f g h m)*
      (-(t+e+d)*(t-f)*(t-f-g))+UpperInner.odd d e f g h m t*(t+e)*(t-f-g) =
      (t-f-g)^2*q0 d e f g h m t := by
  unfold UpperInner.weight UpperInner.weightedRoot UpperInner.odd q0 q00 q01 q02
  ring

def q10 (d e f g h m : R) : R :=
  ((((((1) * f + ((3) * g + ((1) * h))) * f + (((3) * g + ((2) * h)) * g)) * f + (((1) * g +
    ((1) * h)) * g ^ 2)) * e + ((((((1) * m + (2)) * f + (((3) * m + (8)) * g + (((1) * m + (2))
    * h))) * f + ((((3) * m + (12)) * g + (((2) * m + (6)) * h)) * g)) * f + ((((1) * m + (8)) *
    g + (((1) * m + (6)) * h)) * g ^ 2)) * f + (((2) * g + ((2) * h)) * g ^ 3))) * e + (((((((1)
    * m + (1)) * f + (((3) * m + (5)) * g + (((1) * m + (1)) * h))) * f + ((((3) * m + (10)) * g
    + (((2) * m + (4)) * h)) * g)) * f + ((((1) * m + (10)) * g + (((1) * m + (6)) * h)) * g ^
    2)) * f + (((5) * g + ((4) * h)) * g ^ 3)) * f + (((1) * g + ((1) * h)) * g ^ 4))) * d +
    (((((((1) * f + ((3) * g + ((1) * h))) * f + (((3) * g + ((2) * h)) * g)) * f + (((1) * g +
    ((1) * h)) * g ^ 2)) * e + (((((3) * f + ((11) * g + ((3) * h))) * f + (((15) * g + ((8) *
    h)) * g)) * f + (((9) * g + ((7) * h)) * g ^ 2)) * f + (((2) * g + ((2) * h)) * g ^ 3))) * e
    + (((((((1) * m + (3)) * f + (((3) * m + (13)) * g + ((3) * h))) * f + ((((3) * m + (22)) *
    g + (((-1) * m + (10)) * h)) * g + (((-1) * m) * h ^ 2))) * f + (((((1) * m + (18)) * g +
    (((-2) * m + (12)) * h)) * g + (((-2) * m) * h ^ 2)) * g)) * f + ((((7) * g + (((-1) * m +
    (6)) * h)) * g + (((-1) * m) * h ^ 2)) * g ^ 2)) * f + (((1) * g + ((1) * h)) * g ^ 4))) * e
    + ((((((((1) * m + (1)) * f + (((4) * m + (5)) * g + (((1) * m + (1)) * h))) * f + ((((6) *
    m + (10)) * g + (((3) * m + (4)) * h)) * g)) * f + ((((4) * m + (10)) * g + (((3) * m + (6))
    * h)) * g ^ 2)) * f + ((((1) * m + (5)) * g + (((1) * m + (4)) * h)) * g ^ 3)) * f + (((1) *
    g + ((1) * h)) * g ^ 4)) * f))

def q11 (d e f g h m : R) : R :=
  (((((-1) * m) * g ^ 2) * f + (((-1) * m) * g ^ 3)) * d + (((((-2) * f + ((-4) * g + ((-2) *
    h))) * f + (((-2) * g + ((-2) * h)) * g)) * e + (((((-2) * m + (-4)) * f + (((-4) * m +
    (-12)) * g + (((-3) * m + (-4)) * h))) * f + ((((-4) * m + (-12)) * g + (((-4) * m + (-8)) *
    h)) * g)) * f + ((((-2) * m + (-4)) * g + (((-1) * m + (-4)) * h)) * g ^ 2))) * e +
