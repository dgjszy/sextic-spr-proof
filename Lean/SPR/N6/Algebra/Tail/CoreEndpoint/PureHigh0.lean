/-- Complete A^0 coefficient of the squares expression. -/
def squares (e f g v : ℝ) : ℝ :=
  (((((((((384) * v ^ 2) * g) * e + (((1600) * v ^ 2) * g ^ 2)) * e + ((((2384) * v ^ 2) * g ^
    2) * f + (((2848) * v ^ 2) * g ^ 3))) * e + ((((8584) * v ^ 2) * g ^ 3) * f + (((2832) * v ^
    2) * g ^ 4))) * e ^ 2 + ((((8196) * v ^ 2) * g ^ 5) * f + (((1720) * v ^ 2) * g ^ 6))) * e +
    ((((3436) * v ^ 2) * g ^ 6) * f + (((652) * v ^ 2) * g ^ 7))) * e + ((((314) * v ^ 2) * g ^
    7) * f)) * e ^ 4

/-- First cone, with no omitted coefficient. -/
theorem left_identity (e f g v : ℝ) : source (e+g) f g v = left e f g v := by
  unfold source left
  ring
/-- Second cone, including the coefficients of the whole square sum. -/
theorem right_identity (e f g v : ℝ) : source e f (e+g) v =
    remainder e f g v+squares e f g v := by
  unfold source remainder squares
  ring
/-- The two coefficient remainders have nonnegative coefficients. -/
theorem signs {e f g v : ℝ} (he : 0 ≤ e) (hf : 0 ≤ f) (hg : 0 ≤ g) (hv : 0 ≤ v) :
    0 ≤ left e f g v ∧ 0 ≤ remainder e f g v := by
  constructor
  · unfold left; positivity
  · unfold remainder; positivity
end
