-- Exact fixed coefficient normalization, with all terms retained.
theorem left_identity (e f g v : ℝ) : source (e+g) f g v =
    remainder e f g v+squares e f g v := by
  unfold source remainder squares
  ring
set_option maxHeartbeats 0 in
-- Exact second-cone normalization.
theorem right_identity (e f g v : ℝ) : source e f (e+g) v = right e f g v := by
  unfold source right
  ring
/-- The two coefficient remainders have nonnegative coefficients. -/
theorem signs {e f g v : ℝ} (he : 0 ≤ e) (hf : 0 ≤ f) (hg : 0 ≤ g) (hv : 0 ≤ v) :
    0 ≤ remainder e f g v ∧ 0 ≤ right e f g v := by
  constructor
  · unfold remainder; positivity
  · unfold right; positivity
end
end SPR.N6.Tail.CoreEndpoint.PureLow2
