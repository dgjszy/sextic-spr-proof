/- The e≥g cone has nonnegative coefficients after e↦e+g. -/
theorem left_signs {e f g v : ℝ} (he : 0 ≤ e) (hf : 0 ≤ f)
    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ left e f g v := by
  unfold left
  positivity

/- The g≥e square remainder has nonnegative coefficients. -/
theorem remainder_signs {e f g v : ℝ} (he : 0 ≤ e) (hf : 0 ≤ f)
    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ remainder e f g v := by
  unfold remainder
  positivity

