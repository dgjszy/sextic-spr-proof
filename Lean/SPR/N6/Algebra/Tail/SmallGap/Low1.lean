/-- Both closed inner-gap cones cover the coefficient, including equality. -/
theorem nonnegative200 {A e g v : ℝ} (hA : 0 ≤ A) (he : 0 ≤ e)
    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ coefficient200 A e g v := by
  rcases le_total g e with hge | heg
  · have hh : e = (e-g)+g := by ring
    rw [hh, left_identity200]
    have hr : 0 ≤ leftRemainder200 A (e-g) g v := by
      unfold leftRemainder200
      positivity
    have hs : 0 ≤ leftSquares200 A (e-g) g v := by
      unfold leftSquares200
      positivity
    exact add_nonneg hr hs
  · have hh : g = e+(g-e) := by ring
    rw [hh, right_identity200]
    have hr : 0 ≤ rightRemainder200 A e (g-e) v := by
      unfold rightRemainder200
      positivity
    have hs : 0 ≤ rightSquares200 A e (g-e) v := by
      unfold rightSquares200
      positivity
    exact add_nonneg hr hs

