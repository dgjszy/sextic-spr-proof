    * H))) * S + (((2) * H) * D + ((-1) * H ^ 2))) * f + ((((6) * S + ((2) * D)) * S) * g)) * f
    + (((1) * S ^ 2) * g ^ 2))) * e + ((((((7) * S + ((10) * D + ((1) * H))) * S + (((2) * D +
    ((1) * H)) * D)) * f + ((((10) * S + ((8) * D + ((1) * H))) * S + (((1) * H) * D)) * g)) * f
    + ((((3) * S + ((1) * D)) * S) * g ^ 2)) * f)) * e + ((((((2) * S + ((7) * D)) * S + (((4) *
    D + ((-1) * H)) * D)) * f + ((((4) * S + ((9) * D)) * S + (((3) * D + ((-1) * H)) * D)) *
    g)) * f + ((((2) * S + ((2) * D)) * S) * g ^ 2)) * f ^ 2)) * e + ((((((2) * D) * S + ((2) *
    D ^ 2)) * f + ((((4) * D) * S + ((3) * D ^ 2)) * g)) * f + ((((2) * D) * S + ((1) * D ^ 2))
    * g ^ 2)) * f ^ 3)

set_option maxHeartbeats 0 in
/-- Exact quadratic interpolation after substituting `m=(e+f+g)/f`. -/
theorem q00_identity (e f g S D H : ℝ) (hf : f ≠ 0) :
    OuterHomogeneous.quadratic
        (fun d h => LowerZero.q00 d e f g h ((e+f+g)/f))
        S (f*D) (f*H) =
      2*(e+f+g)*z00 e f g S D H := by
  unfold OuterHomogeneous.quadratic LowerZero.q00 z00
  field_simp
  <;> ring

