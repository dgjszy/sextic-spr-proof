def rightSquares002 (A e g v : ℝ) : ℝ :=
  (204 : ℝ)*(A^4*e^3*g)*((1 : ℝ)*(e^2) + (-1 : ℝ)*(g*v))^2 + (135 : ℝ)*(A^4*e^4*g^2)*((1 :
    ℝ)*(g) + (-1 : ℝ)*(v))^2

set_option maxHeartbeats 0 in
/-- Exact reduced-source identity in the g ge e cone. -/
theorem right_identity002 (A e g v : ℝ) :
    coefficient002 A e (e+g) v = rightRemainder002 A e g v + rightSquares002 A e g v := by
  unfold coefficient002 rightRemainder002 rightSquares002
  ring

set_option maxHeartbeats 0 in
/-- The remainder and square certificate are nonnegative on the closed orthant. -/
theorem right_nonnegative002 {A e g v : ℝ} (hA : 0 ≤ A) (he : 0 ≤ e)
    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ coefficient002 A e (e+g) v := by
  rw [right_identity002]
  have hr : 0 ≤ rightRemainder002 A e g v := by
    unfold rightRemainder002
    positivity
  have hs : 0 ≤ rightSquares002 A e g v := by
    unfold rightSquares002
    positivity
  exact add_nonneg hr hs

set_option maxHeartbeats 0 in
/-- Both closed inner-gap cones cover the coefficient, including equality. -/
theorem nonnegative002 {A e g v : ℝ} (hA : 0 ≤ A) (he : 0 ≤ e)
    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ coefficient002 A e g v := by
  rcases le_total g e with hge | heg
  · have hh : e = (e-g)+g := by ring
    rw [hh, left_identity002]
    have hr : 0 ≤ leftRemainder002 A (e-g) g v := by
      unfold leftRemainder002
      positivity
    have hs : 0 ≤ leftSquares002 A (e-g) g v := by
      unfold leftSquares002
      positivity
    exact add_nonneg hr hs
  · have hh : g = e+(g-e) := by ring
    rw [hh, right_identity002]
    have hr : 0 ≤ rightRemainder002 A e (g-e) v := by
      unfold rightRemainder002
      positivity
    have hs : 0 ≤ rightSquares002 A e (g-e) v := by
      unfold rightSquares002
      positivity
    exact add_nonneg hr hs

end
