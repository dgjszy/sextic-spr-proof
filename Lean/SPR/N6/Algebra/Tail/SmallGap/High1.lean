    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ coefficient200 A (e+g) g v := by
  rw [left_identity200]
  have hr : 0 ≤ leftRemainder200 A e g v := by
    unfold leftRemainder200
    positivity
  have hs : 0 ≤ leftSquares200 A e g v := by
    unfold leftSquares200
    positivity
  exact add_nonneg hr hs

