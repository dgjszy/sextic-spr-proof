/-- Exact reduced-source identity in the e ge g cone. -/
theorem left_identity200 (A e g v : ℝ) :
    coefficient200 A (e+g) g v = leftRemainder200 A e g v + leftSquares200 A e g v := by
  unfold coefficient200 leftRemainder200 leftSquares200
  ring

set_option maxHeartbeats 0 in
/-- The remainder and square certificate are nonnegative on the closed orthant. -/
