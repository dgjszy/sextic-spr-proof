/-- Both closed inner-gap cones cover the coefficient, including equality. -/
theorem nonnegative020 {A e g v : ℝ} (hA : 0 ≤ A) (he : 0 ≤ e)
    (hg : 0 ≤ g) (hv : 0 ≤ v) : 0 ≤ coefficient020 A e g v := by
