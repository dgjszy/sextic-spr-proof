    (hf : 0 ≤ f) (hg : 0 ≤ g) (hh : 0 ≤ h) :
    0 ≤ remainder d e f g h ∧ 0 ≤ multiplier d e f g h := by
  constructor
  · unfold remainder; positivity
  · unfold multiplier; positivity

