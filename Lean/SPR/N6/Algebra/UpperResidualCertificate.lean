set_option maxRecDepth 4096

/-- The exact discriminant complement of D1 D2 times the upper residual. -/
def source (a A B b c C : ℝ) : ℝ :=
  let D1 := (b-a)*(c-a)
  let D2 := (C-A)*(C-B)
  let q0 := b*(C-b)*(c-a)*D2
  let q1 := -C*(c-b)*D1-(b*(c-a)+a*(C-b))*D2
  let q2 := a*D2+C*D1
  4*q0*q2-q1^2

