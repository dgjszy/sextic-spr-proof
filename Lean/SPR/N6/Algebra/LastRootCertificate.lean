/-!
# The last even root lies beyond the last denominator root

The certificate is a positive polynomial in all six strict root gaps after
subtracting a nonnegative width-budget term. Both its original rational identity
and its sign are checked in Lean. The result supplies the last-root input to the
frequency assembly without a new hypothesis.
-/
namespace SPR.N6.LastRootCertificate
noncomputable section

/-- The original denominator-cleared expression in the six ordered roots. -/
def source (a A B b c C : ℝ) : ℝ :=
  let D1 := (b-a)*(c-a)
  let D2 := (C-A)*(C-B)
  let D := D1*D2
  let l2 := a*D2+C*D1
  let l1 := -a*(A+B)*D2-(a*C+A*B)*D1
  let l0 := a*A*B*(D1+D2)
  let f2 := D-l1+(b+c-a)*l2
  let f1 := a*f2-(A+B)*D-l0+(b+c)*l1-b*c*l2
  let f0 := A*B*b*c*(D1+D2)
  f0+f1*C+f2*C*(2*C-b)-l2*C^3

/-- Slack in the actual first-two-width budget, with κ=d+h-f. -/
def widthSlack (a d e f g h : ℝ) : ℝ :=
  f*(f+g)-d*(e+2*f+g)-(2*d+e+2*a)*(d+h-f)

/-- A manifestly nonnegative multiplier of the actual width slack. -/
def multiplier (f g h : ℝ) : ℝ := h^2*(h^2+(2*f+3*g)*h+2*g^2)

